  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dragon Quest Minstrel Song\n\r\n- PROYECTO FORMATIVO -\r\nEste videojuego
    es el resultado de mi formaci\xF3n en el \r\ncurso de Programaci\xF3n de Videojuegos
    con Unity en el \r\ncentro E-Talent (Telde). Se trata de mi primer proyecto \r\noficial
    en el g\xE9nero de RPG 2D, desarrollado \xEDntegramente \r\ncomo parte de mi
    especializaci\xF3n t\xE9cnica.\r\n\r\nEste juego ha sido realizado con fines
    educativos para \r\nel curso \"IFCD57 PROGRAMACI\xD3N PARA VIDEOJUEGOS UNITY\".\r\n\r\n\r\n-
    PROGRAMACI\xD3N Y DISE\xD1O -\nDesarrollado \xEDntegramente por:\nMaErGa - RetroMetalGamer\n\r\n\r\n-
    GR\xC1FICOS Y ANIMACIONES -\r\nSprites de Dragon Quest III\r\n(Propiedad de Square
    Enix)\r\n\r\nSprites de Lunar: Silver Star Story (PS1)\r\n(Propiedad de Game
    Arts / Kadokawa Shoten)\r\n\r\nRecursos obtenidos de:\r\nThe Spriters Resource\r\n\r\n\r\n-
    DOBLAJE Y BANDA SONORA -\r\nEfectos de sonido originales de Dragon Quest\r\n(Composici\xF3n
    de Koichi Sugiyama / Propiedad de Square Enix)\r\n\r\nM\xFAsica de ambiente y
    exploraci\xF3n obtenida de:\r\nOpenGameArt.org\r\n\r\n\r\n- TECNOLOG\xCDAS UTILIZADAS
    -\r\nMotor de Desarrollo: Unity 2022\r\nMaquetaci\xF3n de Texto: TextMeshPro\r\n\r\n\r\n-
    AGRADECIMIENTOS -\r\nAl centro de formaci\xF3n E-Talent (Telde)\r\nA los docentes
    del curso \"IFCD57\"\r\nY a todas las personas que apoyan la formaci\xF3n t\xE9cnica\r\n\r\n\xA1MUCHAS
    GRACIAS POR JUGAR!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
